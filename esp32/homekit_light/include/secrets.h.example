// Copy this file to secrets.h (same folder). secrets.h is gitignored --
// it will never be committed or pushed. WiFi credentials are NOT stored
// here (or anywhere in source) -- see the Setup Access Point flow in
// main.cpp's comments / the conversation for how those get configured
// directly on the device instead.

// Must be a genuine random 8-digit code, no dashes -- HomeKit rejects
// trivial ones (sequential, all-same-digit, etc). This is what you'll
// type into the Home app once, during pairing (it'll be displayed there
// as REDACTED_ROTATED_CODE).
#define HOMEKIT_SETUP_CODE "REDACTED_ROTATED_CODE"
