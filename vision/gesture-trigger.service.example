; Copy to /etc/systemd/system/gesture-trigger.service on the Pi, then:
;   sudo systemctl daemon-reload
;   sudo systemctl enable --now gesture-trigger

[Unit]
Description=Raised-hand gesture trigger for bedroom light

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/auto_turn_lights_on/vision
Environment=CODE_VALUE=5592371
Environment=CODE_BIT_LENGTH=24
Environment=CODE_PULSE_LENGTH=350
Environment=CODE_PROTOCOL=1
ExecStart=/home/pi/auto_turn_lights_on/vision/venv/bin/python3 gesture_trigger.py
Restart=on-failure
RestartSec=3

; rpi-rf needs GPIO access; either run as root or add the 'pi' user to the gpio group.

[Install]
WantedBy=multi-user.target
